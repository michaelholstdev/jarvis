{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "role"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "hello"
        },
        "role": {
          "enum": ["core", "cli"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "service", "mode"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ready"
        },
        "service": {
          "const": "audio"
        },
        "mode": {
          "const": "mock"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "service", "status"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ready"
        },
        "service": {
          "const": "core"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "mode",
            "state",
            "manual_activation",
            "voice_conversation",
            "audio",
            "since_ms",
            "audio_diagnostic"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "mode": {
              "const": "mock"
            },
            "state": {
              "enum": [
                "idle",
                "acknowledging",
                "listening",
                "thinking",
                "synthesizing",
                "speaking"
              ]
            },
            "manual_activation": {
              "enum": ["mock", "unavailable"]
            },
            "voice_conversation": {
              "const": "unavailable"
            },
            "audio": {
              "enum": ["ready", "unavailable"]
            },
            "since_ms": {
              "type": "number",
              "minimum": 0
            },
            "audio_diagnostic": {
              "enum": [
                "invalid_message",
                "incompatible_version",
                "frame_too_large",
                "timeout",
                "unavailable",
                "busy",
                null
              ]
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "code"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "invalid_message",
            "incompatible_version",
            "frame_too_large",
            "timeout",
            "unavailable",
            "busy"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "activate"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "text"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "demo"
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "operation"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "audio-operation"
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operation_id"],
          "properties": {
            "type": {
              "enum": ["acknowledge", "recognize", "synthesize", "play"]
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "operation_id"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "audio-result"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "completed": {
          "type": "boolean"
        },
        "delivered_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4096
        }
      }
    }
  ]
}
