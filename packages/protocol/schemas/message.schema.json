{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "role"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "hello"
        },
        "role": {
          "enum": ["core", "cli"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "service", "mode"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ready"
        },
        "service": {
          "const": "audio"
        },
        "mode": {
          "enum": ["mock", "piper", "voice"]
        },
        "capabilities": {
          "$ref": "#/definitions/capabilities"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "service", "status"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "ready"
        },
        "service": {
          "const": "core"
        },
        "status": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ready",
            "mode",
            "state",
            "manual_activation",
            "voice_conversation",
            "audio",
            "since_ms",
            "audio_diagnostic",
            "state_since_ms",
            "inhibitions",
            "privacy_pending",
            "capabilities",
            "retry_available",
            "last_failure",
            "audio_cleanup_pending"
          ],
          "properties": {
            "ready": {
              "type": "boolean"
            },
            "mode": {
              "const": "mock"
            },
            "state": {
              "enum": [
                "idle",
                "acknowledging",
                "listening",
                "thinking",
                "synthesizing",
                "speaking",
                "follow-up",
                "awaiting-extension",
                "cancelling",
                "indicating-failure"
              ]
            },
            "manual_activation": {
              "enum": ["mock", "unavailable", "ready"]
            },
            "voice_conversation": {
              "enum": ["unavailable", "ready"]
            },
            "audio": {
              "enum": ["ready", "unavailable"]
            },
            "since_ms": {
              "type": "number",
              "minimum": 0
            },
            "audio_diagnostic": {
              "enum": [
                "invalid_message",
                "incompatible_version",
                "frame_too_large",
                "timeout",
                "unavailable",
                "busy",
                null
              ]
            },
            "state_since_ms": {
              "type": "number",
              "minimum": 0
            },
            "inhibitions": {
              "$ref": "#/definitions/inhibitions"
            },
            "privacy_pending": {
              "type": "boolean"
            },
            "capabilities": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "wake": {
                  "enum": ["mock", "ready", "unavailable"]
                },
                "stt": {
                  "enum": ["mock", "ready", "unavailable"]
                },
                "tts": {
                  "enum": ["mock", "ready", "unavailable"]
                },
                "inference": {
                  "enum": ["mock", "ready", "unavailable"]
                }
              },
              "required": ["wake", "stt", "tts", "inference"]
            },
            "retry_available": {
              "type": "boolean"
            },
            "last_failure": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "capability"],
                  "properties": {
                    "code": {
                      "enum": [
                        "invalid_message",
                        "incompatible_version",
                        "frame_too_large",
                        "timeout",
                        "unavailable",
                        "busy"
                      ]
                    },
                    "capability": {
                      "enum": ["audio", "wake", "stt", "tts", "inference"]
                    }
                  }
                }
              ]
            },
            "audio_cleanup_pending": {
              "type": "boolean"
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "code"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "code": {
          "enum": [
            "invalid_message",
            "incompatible_version",
            "frame_too_large",
            "timeout",
            "unavailable",
            "busy"
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "enum": ["activate", "stop"]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "text"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "demo"
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "operation"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "audio-operation"
        },
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "operation_id"],
          "properties": {
            "type": {
              "enum": [
                "acknowledge",
                "recognize",
                "synthesize",
                "play",
                "close-conversation",
                "cancel",
                "privacy",
                "indicate-failure"
              ]
            },
            "operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "text": {
              "type": "string",
              "maxLength": 4096
            },
            "sound": {
              "type": "boolean"
            },
            "target_operation_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "inhibitions": {
              "$ref": "#/definitions/inhibitions"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "cancel"
                  }
                }
              },
              "then": {
                "required": ["target_operation_id"]
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "privacy"
                  }
                }
              },
              "then": {
                "required": ["inhibitions"]
              }
            }
          ]
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "operation_id"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "audio-result"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "text": {
          "type": "string",
          "maxLength": 4096
        },
        "completed": {
          "type": "boolean"
        },
        "delivered_chars": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8192
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "source", "active"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "inhibition-changed"
        },
        "source": {
          "enum": ["locked", "muted", "hardware_muted"]
        },
        "active": {
          "type": "boolean"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "operation_id"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "speech-started"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "text-answer-request"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "text"],
      "properties": {
        "version": {
          "const": 1
        },
        "type": {
          "const": "text-answer"
        },
        "text": {
          "type": ["string", "null"],
          "maxLength": 4096
        }
      }
    }
  ],
  "definitions": {
    "inhibitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locked", "muted", "hardware_muted"],
      "properties": {
        "locked": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        },
        "hardware_muted": {
          "type": "boolean"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wake": {
          "enum": ["mock", "ready", "unavailable"]
        },
        "stt": {
          "enum": ["mock", "ready", "unavailable"]
        },
        "tts": {
          "enum": ["mock", "ready", "unavailable"]
        },
        "inference": {
          "enum": ["mock", "ready", "unavailable"]
        }
      }
    }
  }
}
