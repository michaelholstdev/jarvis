{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noUncheckedIndexedAccess": true, "resolveJsonModule": true, "outDir": "dist",
    "rootDir": ".", "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["apps/core/**/*.ts", "packages/**/*.ts", "tests/**/*.ts"]
}
