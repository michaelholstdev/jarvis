[Unit]
Description=Jarvis local audio service
After=graphical-session.target pipewire.service pipewire-pulse.service
Wants=pipewire.service pipewire-pulse.service
PartOf=graphical-session.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/.local/share/jarvis
ExecStartPre=%h/.local/share/jarvis/.venv/bin/python scripts/service-runtime.py prepare audio
ExecStart=%h/.local/share/jarvis/.venv/bin/python apps/audio/main.py
ExecStartPost=%h/.local/share/jarvis/.venv/bin/python scripts/service-runtime.py wait audio
Restart=on-failure
RestartSec=15s
TimeoutStartSec=60s
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
LimitCORE=0
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=graphical-session.target
